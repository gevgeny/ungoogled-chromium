+// Sticky tab: remembers a home URL and a custom title. Pinned tabs are always
+// sticky. See ungoogled-chromium/docs/sticky-tabs.md.
+class StickyTabController : public ContentsObservingTabFeature {
+ public:
+  DECLARE_USER_DATA(StickyTabController);
+
+  static StickyTabController* From(TabInterface* tab);
+  static const StickyTabController* From(const TabInterface* tab);
+
+  // First index after pinned tabs and the run of sticky tabs following them.
+  static int IndexOfFirstNonStickyTab(const TabStripModel& model);
+
+  // Session persistence via the tab's session `extra_data`.
+  static void PopulateExtraData(const TabInterface* tab,
+                                std::map<std::string, std::string>* extra_data);
+  // Called on restore before the tab exists; picked up by the constructor.
+  static void StashExtraData(
+      content::WebContents* contents,
+      const std::map<std::string, std::string>& extra_data);
+
+  explicit StickyTabController(TabInterface* tab);
+  StickyTabController(const StickyTabController&) = delete;
+  StickyTabController& operator=(const StickyTabController&) = delete;
+  ~StickyTabController() override;
+
+  bool is_sticky() const { return sticky_; }
+  bool has_left_home() const { return left_home_; }
+  const std::u16string& title() const { return title_; }
+  const GURL& home_url() const { return home_url_; }
+
+  // Stores current URL + title as home state. Unpinned tabs leave their group
+  // and move right after the pinned + sticky tabs.
+  void MakeSticky();
+  void RemoveSticky();
+  // Loads home URL and drops back/forward history.
+  void ResetToHome();
+  void SetHomeToCurrent();
+  void SetTitle(const std::u16string& title);
+  // Modal dialog with a text field; empty name falls back to the page title.
+  void ShowRenameDialog();
+  // Applies saved state without moving the tab (restore, startup).
+  void RestoreState(const GURL& home_url, const std::u16string& title);
+
+ private:
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* navigation) override;
+
+  void OnPinnedStateChanged(TabInterface* tab, bool pinned);
+  void SetLeftHome(bool left_home);
+  // Redraws the tab (title, attention dot) and refreshes menu state.
+  void NotifyChanged();
+  // Writes state to the session and, for pinned tabs, the pinned_tabs pref.
+  void Persist();
+
+  bool sticky_ = false;
+  bool left_home_ = false;
+  bool prune_history_on_commit_ = false;
+  std::u16string title_;
+  GURL home_url_;
+  base::CallbackListSubscription pinned_subscription_;
+  ui::ScopedUnownedUserData<StickyTabController> scoped_data_holder_;
+  base::WeakPtrFactory<StickyTabController> weak_factory_{this};
+};
+
